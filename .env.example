# Copy to .env (gitignored) for local runs. The grader sets these itself.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Or any Anthropic-compatible endpoint while developing, e.g. DeepSeek's.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# NOVA_MODEL=deepseek-chat
# Default model is claude-opus-5 (the one validated); claude-sonnet-5 is cheaper.
# NOVA_MODEL=claude-haiku-4-5
# Local runs only: share model answers across state dirs (the grader never sets this).
# NOVA_CACHE_DIR=.llm_cache
