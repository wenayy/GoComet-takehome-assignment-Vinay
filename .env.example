# Copy to .env (gitignored) for local runs. The grader sets these itself.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: any Anthropic-compatible endpoint while developing, e.g. DeepSeek's.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# NOVA_MODEL=deepseek-chat
# Default model is claude-sonnet-5; claude-haiku-4-5 is a cheaper option for trial runs.
# NOVA_MODEL=claude-haiku-4-5
